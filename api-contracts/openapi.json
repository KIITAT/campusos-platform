  "components": {
    "schemas": {
      "CreateInstitution": {
        "type": "object",
        "properties": {
          "slug": {
            "$ref": "#/components/schemas/Slug"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "allowedEmailDomains": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmailDomain"
            }
          },
          "customDomain": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 253
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "slug",
          "name",
          "allowedEmailDomains"
        ]
      },
      "Slug": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40,
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
        "example": "xyzcollege"
      },
      "EmailDomain": {
        "type": "string",
        "minLength": 3,
        "maxLength": 253,
        "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$",
        "example": "xyzcollege.edu.in"
      },
      "AssignRole": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "super_admin",
              "institution_admin",
              "hod",
              "faculty",
              "accounts_staff",
              "library_staff",
              "hostel_staff",
              "student",
              "parent"
            ]
          }
        },
        "required": [
          "userId",
          "role"
        ]
      },
      "ToggleModule": {
        "type": "object",
        "properties": {
          "institutionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "moduleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "institutionId",
          "moduleId",
          "enabled"
        ]
      },
      "AcademicCreateDepartment": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "example": "CSE"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "code",
          "name"
        ]
      },
      "AcademicCreateProgram": {
        "type": "object",
        "properties": {
          "departmentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "example": "CSE"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "level": {
            "type": "string",
            "enum": [
              "certificate",
              "diploma",
              "undergraduate",
              "postgraduate",
              "doctoral"
            ]
          },
          "durationTerms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          }
        },
        "required": [
          "departmentId",
          "code",
          "name",
          "level",
          "durationTerms"
        ]
      },
      "AcademicCreateCourse": {
        "type": "object",
        "properties": {
          "departmentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24,
            "example": "CSE"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "credits": {
            "type": "integer",
            "minimum": 0,
