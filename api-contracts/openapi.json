    "/api/v1/modules/academic/timetable": {
      "get": {
        "summary": "The weekly timetable for the current term, scoped to the caller: their cohorts if a student, what they teach if a lecturer, the whole institution for an admin",
        "tags": [
          "academic"
        ],
        "responses": {
          "200": {
            "description": "OK. An empty timetable when no term is current.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcademicTimetable"
                }
              }
            }
          },
          "403": {
            "description": "Module not enabled for this institution",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "error",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
