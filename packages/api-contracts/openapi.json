{
  "openapi": "3.1.0",
  "info": {
    "title": "CampusOS API",
    "version": "0.0.0",
    "description": "Multi-tenant college ERP. Tenant is resolved from the request host; every tenant-scoped read is additionally enforced by Postgres RLS."
  },
  "paths": {
    "/api/v1/me": {
      "get": {
        "summary": "The signed-in user, their role, and the modules their institution has enabled",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/institutions": {
      "post": {
        "summary": "Create an institution (super_admin only)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInstitution"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Institution"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Slug or email domain already taken",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/role": {
      "post": {
        "summary": "Approve a pending user and assign a role (institution_admin or super_admin)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssignRole"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Assigned"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such user in this institution",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices": {
      "get": {
        "summary": "Devices paired to this account",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "summary": "Generate a pairing code for a phone",
        "description": "Six characters, ten minutes, single use. It exists so the long-lived device token never travels through a screenshot or a chat message.",
        "responses": {
          "200": {
            "description": "A code, shown once"
          }
        }
      }
    },
    "/api/v1/devices/claim": {
      "post": {
        "summary": "Exchange a pairing code for a device token",
        "description": "The one unauthenticated endpoint that grants a credential -- the phone has none yet. A wrong, expired or malformed code returns the same 401, so guessing learns nothing. The token is then sent as `Authorization: Bearer`; everything downstream (the module gate, each operation’s own checks, RLS) is identical to a browser session, so the mobile client can never reach anything the web client cannot.",
        "responses": {
          "200": {
            "description": "A device token, shown once"
          },
          "401": {
            "description": "Not a valid code",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/devices/revoke": {
      "post": {
        "summary": "Revoke a device immediately",
        "responses": {
          "204": {
            "description": "Revoked"
          },
          "404": {
            "description": "No such device",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/consent": {
      "get": {
        "summary": "Whether this person has agreed to the privacy notice in force",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentState"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Record consent to the notice currently in force",
        "description": "The version shown is stored alongside, so \"what did they agree to\" has an answer after the notice is rewritten.",
        "responses": {
          "204": {
            "description": "Recorded"
          }
        }
      }
    },
    "/api/v1/me/export": {
      "get": {
        "summary": "Everything held about one person, as JSON",
        "description": "Assembled by walking the foreign keys to `users`, so a module added next year is covered without anybody remembering to edit an export list.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "403": {
            "description": "Not yours to export",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/erase": {
      "post": {
        "summary": "Erase a person, keeping the institution’s records",
        "description": "Anonymisation, not deletion: a fee receipt, a mark and an attendance register are the institution’s own records with their own retention obligations. The identifying fields go and the rows that referenced them become unattributable. Refused for the last remaining administrator.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EraseUser"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Erased"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "That is the only administrator",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/modules/toggle": {
      "post": {
        "summary": "Enable or disable a module for an institution (super_admin only)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToggleModule"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Toggled"
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Dependencies not enabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateInstitution": {
        "type": "object",
        "properties": {
          "slug": {
            "$ref": "#/components/schemas/Slug"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "allowedEmailDomains": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmailDomain"
            }
          },
          "customDomain": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 253
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "slug",
          "name",
          "allowedEmailDomains"
        ]
      },
      "Slug": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40,
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
        "example": "xyzcollege"
      },
      "EmailDomain": {
        "type": "string",
        "minLength": 3,
        "maxLength": 253,
        "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$",
        "example": "xyzcollege.edu.in"
      },
      "AssignRole": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "super_admin",
              "institution_admin",
              "hod",
              "faculty",
              "accounts_staff",
              "library_staff",
              "hostel_staff",
              "student",
              "parent"
            ]
          }
        },
        "required": [
          "userId",
          "role"
        ]
      },
      "EraseUser": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          }
        },
        "required": [
          "userId",
          "reason"
        ]
      },
      "ToggleModule": {
        "type": "object",
        "properties": {
          "institutionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "moduleId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "institutionId",
          "moduleId",
          "enabled"
        ]
      },
      "PricingModel": {
        "type": "string",
        "enum": [
          "included_in_base",
          "flat_monthly",
          "per_student_monthly",
          "not_priced_yet"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "institutionId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "null"
              }
            ]
          },
          "institutionSlug": {
            "type": [
              "string",
              "null"
            ]
          },
          "enabledModules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role",
          "institutionId",
          "institutionSlug",
          "enabledModules"
        ],
        "additionalProperties": false
      },
      "Role": {
        "type": "string",
        "enum": [
          "super_admin",
          "institution_admin",
          "hod",
          "faculty",
          "accounts_staff",
          "library_staff",
          "hostel_staff",
          "student",
          "parent",
          "pending"
        ],
        "description": "A user role within an institution"
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ],
        "additionalProperties": false
      },
      "Institution": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "slug": {
            "$ref": "#/components/schemas/Slug"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "customDomain": {
            "type": [
              "string",
              "null"
            ]
          },
          "allowedEmailDomains": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmailDomain"
            }
          },
          "suspendedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "customDomain",
          "allowedEmailDomains",
          "suspendedAt"
        ],
        "additionalProperties": false
      },
      "ConsentState": {
        "type": "object",
        "properties": {
          "current": {
            "type": "boolean"
          }
        },
        "required": [
          "current"
        ],
        "additionalProperties": false
      },
      "ModuleDenied": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "const": "module_not_enabled"
          },
          "moduleId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "pricing": {
            "type": "object",
            "properties": {
              "model": {
                "$ref": "#/components/schemas/PricingModel"
              },
              "priceINR": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "model",
              "priceINR"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error",
          "moduleId",
          "name",
          "pricing"
        ],
        "additionalProperties": false
      }
    }
  }
}
