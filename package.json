{
  "name": "campusos-platform",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "test": "turbo test --continue --concurrency=1",
    "db:generate": "pnpm -F @campusos/db exec drizzle-kit generate",
    "db:migrate": "pnpm -F @campusos/db exec drizzle-kit migrate",
    "db:check": "pnpm -F @campusos/db exec drizzle-kit check",
    "db:seed": "pnpm -F @campusos/db seed",
    "openapi": "pnpm -F @campusos/api-contracts openapi",
    "pack:plugins": "node scripts/pack-plugins.mjs",
    "registry:index": "node scripts/build-index.mjs",
    "registry:sign": "node scripts/registry-sign.mjs sign dist/registry/registry.json",
    "pack:core": "node scripts/pack-core.mjs",
    "pack:all": "pnpm pack:plugins && pnpm pack:core && pnpm registry:index && pnpm registry:sign"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "pg-types": "^4.1.0",
    "turbo": "^2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
