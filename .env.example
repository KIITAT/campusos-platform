# Copy to .env.local (git-ignored). Local development talks to Docker Postgres.
# Nothing here reaches a hosted database; CI uses a service container.

# app: restricted role, RLS enforced
DATABASE_URL=postgresql://campusos_app:campusos_app@localhost:5432/campusos
# drizzle-kit + seed: owner role, DDL rights
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campusos

# Only the seed and the hostel roll-call token derivation need this here; the
# host application owns the real one.
AUTH_SECRET=
